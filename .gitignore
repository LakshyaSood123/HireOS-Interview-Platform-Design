# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Operational backups contain personal data and password hashes: never commit them.
/deployment/backups/
*.archive.gz
*.archive.gz.sha256

# Narrated course release exports (~90 MB, audio inside the package JSON). Regenerable with backend/scripts/exportCourseRelease.ts;
# store off-machine like database backups, never in Git.
/deployment/releases/
