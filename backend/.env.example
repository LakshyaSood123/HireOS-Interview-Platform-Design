# Reagvis Trails API — environment
# Copy to backend/.env and fill in. Placeholders only in this file; .env is git-ignored.

NODE_ENV=development
PORT=4883
API_PREFIX=/api/v1

# MongoDB Atlas connection string. SECRET — never commit the real value.
# Atlas → Database → Connect → Drivers. Remember to allowlist your IP.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# One database per environment on the same cluster: reagvis_dev | reagvis_test | reagvis_prod
MONGO_DB_NAME=reagvis_dev

# Auth. SECRETS — generate your own, at least 32 characters each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# HTTP
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:3000
TRUST_PROXY=loopback
JSON_BODY_LIMIT=128kb

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Code execution — used from Day 4. Leave as-is until then.
EXECUTION_PROVIDER=piston
PISTON_URL=http://localhost:2000
