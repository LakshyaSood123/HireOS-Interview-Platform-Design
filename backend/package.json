{
  "name": "reagvis-trails-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reagvis Trails backend \u2014 accounts, learner progress, notes, submissions, recommendations.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed": "npm run seed:curriculum",
    "seed:curriculum": "tsx scripts/seedCurriculum.ts",
    "verify:day1": "bash scripts/verify-day1.sh",
    "verify:parity": "tsx scripts/verifyEngineParity.ts",
    "verify:ledger": "tsx scripts/verifyLedger.ts",
    "verify:day2": "bash scripts/verify-day2.sh",
    "verify:adapters": "tsx scripts/verifyAdapters.ts",
    "verify:day3": "bash scripts/verify-day3.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.1",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.12",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^10.2.3",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.7",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
