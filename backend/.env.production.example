# Reagvis Trails API — PRODUCTION / PILOT environment (backend RUNTIME variables).
# Copy to backend/.env on the server (or inject the same variables through your process manager).
# Placeholders only. NEVER commit real values. The server refuses to start in production
# if any rule below is broken (see backend/src/config/env.ts "productionConfigProblems").

NODE_ENV=production
PORT=4883
API_PREFIX=/api/v1

# MongoDB connection string (secret). A dedicated database user is recommended; allow-list only the API host.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# REQUIRED in production. Must not end in _dev or _test.
MONGO_DB_NAME=reagvis_prod

# Secrets: two DIFFERENT random values of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<generate-a-random-48-byte-value>
JWT_REFRESH_SECRET=<generate-a-different-random-48-byte-value>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# REQUIRED in production, no localhost default: the exact https origin(s) of the FRONTEND, comma separated,
# scheme + host only (no path, no wildcard). Example: https://learn.example.org
CORS_ORIGINS=https://<frontend-domain>

# REQUIRED in production. Number of trusted reverse-proxy hops in front of the API: 1 for a single proxy
# (nginx / Caddy / cloud load balancer). Needed for real client IPs (rate limiting) and HTTPS detection.
# Do NOT use "true". Use 0 only if the API is exposed directly to the internet.
TRUST_PROXY=1

JSON_BODY_LIMIT=2mb
LOG_LEVEL=info
LOG_PRETTY=false

# Code execution is not used by the Machine Learning course; keep the defaults.
EXECUTION_PROVIDER=mock
