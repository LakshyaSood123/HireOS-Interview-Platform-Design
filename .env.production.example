# Frontend BUILD-TIME variables (Vite). They are baked into the static bundle by `pnpm build`;
# changing them requires a rebuild. Backend runtime variables live in backend/.env.production.example.
#
# REQUIRED for a production build: `vite build` refuses to run without it, and refuses localhost / plain http.
#   - absolute:      https://api.example.org/api/v1        (API on its own https host; add that host's frontend
#                                                           origin to the backend CORS_ORIGINS)
#   - same-origin:   /api/v1                               (reverse proxy serves the static files AND forwards /api/ to
#                                                           the backend on one host; CORS is then not involved)
VITE_REAGVIS_API_URL=https://<api-domain>/api/v1

# Pilot learner surface (default on): hides the demo navigator, Creator Studio, the unfinished DSA world and the
# mock readiness score from NON-admin accounts. Set to "false" only for development builds.
# VITE_REAGVIS_PILOT_UI=true
